{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift: Build Debug Malkh",
      "type": "shell",
      "command": "swift build --product Malkh && python3 scripts/generate-localizations.py >/dev/null && ditto Resources/Localizations \"$(swift build --show-bin-path)\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Malkh: GitHub'a gönder ve yayınla",
      "type": "shell",
      "command": "scripts/publish.sh ${input:version} ${input:build}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "version",
      "type": "promptString",
      "description": "Sürüm (örn. 1.0.0)",
      "default": "1.0.0"
    },
    {
      "id": "build",
      "type": "promptString",
      "description": "Yapı numarası (her yayında +1)",
      "default": "1"
    }
  ]
}